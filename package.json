{
  "name": "dsh-compact-now",
  "version": "0.1.0",
  "description": "DSH 会话输入框「压缩」按钮：一键执行 /compact 压缩上下文，旧历史折叠成摘要省 token",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "compact",
    "token",
    "context"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/setup-dsh-links.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "esbuild": "^0.24.0"
  }
}
